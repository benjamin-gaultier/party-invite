{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party-invite",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Serve at https://party-invite.<subdomain>.workers.dev.
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "party-invite",
      "database_id": "05210261-556e-4b0e-8a47-c6b6e30904be",
      "migrations_dir": "migrations"
    }
  ],
  // Preview deployments (Workers Builds on non-main branches, `wrangler preview`)
  // use their own database so they never touch production data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "party-invite-preview",
        "database_id": "21d86b3e-9164-4dc0-9446-b75bb31877c6",
        "migrations_dir": "migrations"
      }
    ]
  },
  "observability": { "enabled": true }
}
